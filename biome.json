{
  "$schema": "https://biomejs.dev/schemas/2.3.5/schema.json",
  "assist": { "enabled": false },
  "files": {
    "includes": ["**", "!dist", "!external", "!node_modules"]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noNonNullAssertion": "off"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": "off",
        "noBannedTypes": "off",
        "noUselessEmptyExport": "off"
      },
      "correctness": {
        "noUnusedVariables": "warn",
        "noConstantCondition": "off"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "noControlCharactersInRegex": "off",
        "noDuplicateCase": "off",
        "noDuplicateElseIf": "off",
        "noEmptyInterface": "off"
      }
    }
  },
  "formatter": {
    "enabled": false,
    "indentStyle": "tab",
    "indentWidth": 2,
    "lineWidth": 120
  }
}
