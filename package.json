{
  "name": "teyol",
  "version": "0.1.0",
  "description": "Local-first AI harness for managing identity, memory, and tools across LLMs.",
  "type": "module",
  "main": "dist/cli/main.js",
  "bin": {
    "teyol": "dist/cli/main.js"
  },
  "teyolConfig": {
    "name": "teyol",
    "configDir": ".teyol"
  },
  "imports": {
    "#ai/*": "./dist/ai/*",
    "#agent/*": "./dist/agent/*",
    "#logger": "./dist/logger.js",
    "#tui/*": "./dist/tui/*",
    "#shell/*": "./dist/shell/*",
    "#cli/*": "./dist/cli/*"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/cli/main.js",
    "dev": "tsx --env-file-if-exists=.env src/cli/main.ts",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "check": "biome check --write . && tsc --noEmit",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@mariozechner/jiti": "^2.6.5",
    "@sinclair/typebox": "^0.34.49",
    "@types/mime-types": "^2.1.4",
    "@types/proper-lockfile": "^4.1.4",
    "@types/uuid": "^10.0.0",
    "chalk": "^5.4.1",
    "cli-highlight": "^2.1.11",
    "dotenv": "^16.4.7",
    "effector": "^23.4.4",
    "eventsource": "^2.0.2",
    "file-type": "^19.0.0",
    "get-east-asian-width": "^1.3.0",
    "glob": "^13.0.6",
    "hosted-git-info": "^9.0.2",
    "ignore": "^7.0.5",
    "ink": "^7.0.1",
    "koffi": "^2.9.0",
    "marked": "^15.0.12",
    "mime-types": "^3.0.1",
    "minimatch": "^10.2.5",
    "openai": "6.26.0",
    "partial-json": "^0.1.7",
    "proper-lockfile": "^4.1.2",
    "proxy-agent": "^6.5.0",
    "react": "^19.2.5",
    "undici": "^7.2.1",
    "uuid": "^14.0.0",
    "yaml": "^2.8.3",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.5",
    "@types/hosted-git-info": "^3.0.5",
    "@types/node": "^22.10.5",
    "tsx": "^4.20.3",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
